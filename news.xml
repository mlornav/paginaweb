<media:content url="https://imagenes.elpais.com/resizer/v2/C5TH3ZXS3RF5BDUXM6FSI7NKVY.jpg?auth=93e086957af38baa335bbbedb3fc83067422ba79001bb3debbe45eec5772774a" type="image/jpeg" medium="image">
<media:credit>EL PAÍS</media:credit>
