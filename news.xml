<media:content url="https://imagenes.elpais.com/resizer/v2/XVIO3ZGB7BAGVDAUGS5EBYAJWU.jpg?auth=ea203082e90929a5469be9ea710352bb1bc0ccbbfad7cc891a223ac092e8830e" type="image/jpeg" medium="image">
