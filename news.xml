<media:content url="https://imagenes.elpais.com/resizer/v2/I6AHB4FIO5D6NNJL6QPK6PDMKE.jpg?auth=68fe8b5a8cd1014b4b5529ba253b70138078a67bba715bff0e409dd9d14c542e" type="image/jpeg" medium="image">
