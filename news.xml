<media:content url="https://imagenes.elpais.com/resizer/v2/2KW2XR42N5GUHDF3WOW6FSSXMU.jpg?auth=6e1bc27102e8f4b9496e4f3be79ba08c2f67f4f699dee7f9760813545b8b94de" type="image/jpeg" medium="image">
<media:credit>MEGA (GC Images)</media:credit>
