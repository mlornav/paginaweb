<media:content url="https://imagenes.elpais.com/resizer/v2/4PSAFELZXBDR3GRNYXI6WZAL7E.jpg?auth=14767932d7e98b767b02fff8293889278a3099ef2c2af62859656244904e919f" type="image/jpeg" medium="image">
