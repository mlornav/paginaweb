<media:content url="https://imagenes.elpais.com/resizer/v2/IZJ65BP5SZCQDCB57VV4FKY72I.jpg?auth=632ce32c1646d6a21761f9e633b0df4d747a23aa6499efe67f0dc12b8f508013" type="image/jpeg" medium="image">
